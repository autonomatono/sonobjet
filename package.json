    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
