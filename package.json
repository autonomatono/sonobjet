{
  "name": "sonobjet",
  "version": "0.1.0",
  "private": true,
  "description": "WebGPU + WebAudio causal audiovisual synth, composition engine, and live performance studio for living visceral media objects",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
